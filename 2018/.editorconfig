# BARR-C:2018 editorconfig (generated by gen_artifacts.py)
# EditorConfig forbids inline comments; each rule ID precedes its property.
root = true

[*.{c,h}]
charset = utf-8
# BARRC-3.6.a
end_of_line = lf
# BARRC-3.3.c
insert_final_newline = true
# BARRC-3.5
indent_style = space
# BARRC-3.4.a
indent_size = 4
# BARRC-1.2.a
max_line_length = 80
trim_trailing_whitespace = true
