# BARR-C:2018 clang-format configuration (generated by gen_artifacts.py)
# Enforces the mechanically expressible subset of the standard's format rules.
# Rule IDs refer to BARR-C:2018 / rules.json.
# Requires clang-format 16 or newer (InsertNewlineAtEOF, LineEnding).
# KNOWN LIMIT: Rule 8.3.a (break aligned with its case label) is outside
# clang-format's expressive range and must be checked in code review.
BasedOnStyle: LLVM
ColumnLimit: 80                    # BARRC-1.2.a line width
SortIncludes: Never                # do not reorder a project's include sequence
AlwaysBreakAfterReturnType: AllDefinitions   # book style: function name starts the line (BARRC-3.1.j)
BreakBeforeBraces: Allman          # BARRC-1.3.b brace placement
IndentWidth: 4                     # BARRC-3.4.a indentation
UseTab: Never                      # BARRC-3.5   tabs prohibited
TabWidth: 4
IndentCaseLabels: true             # BARRC-3.4.b case contents indented within switch
SpaceAfterCStyleCast: true
SpaceBeforeParens: Custom          # BARRC-3.1.a keyword spacing + BARRC-3.1.j
SpaceBeforeParensOptions:
  AfterControlStatements: true     # BARRC-3.1.a
  AfterFunctionDeclarationName: true   # BARRC-3.1.j declaration-site space
  AfterFunctionDefinitionName: true    # BARRC-3.1.j
SpacesInParens: Never              # BARRC-3.1.i (SpacesInParentheses deprecated in 17)
PointerAlignment: Middle           # BARRC-3.1.e pointer operators in declarations
AlignConsecutiveDeclarations: true # BARRC-3.2.a/b alignment
AlignConsecutiveAssignments: true  # BARRC-3.2.c
MaxEmptyLinesToKeep: 2
InsertNewlineAtEOF: true           # BARRC-3.3.c file terminator
LineEnding: LF                     # BARRC-3.6.a
